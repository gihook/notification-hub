CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

# Production only (docker-compose.prod.yml): RabbitMQ credentials, required there.
# CELERY_BROKER_URL above must then use the same user/password:
#   CELERY_BROKER_URL=amqp://<user>:<password>@rabbitmq:5672//
# They apply only when the rabbitmq-data volume is first created.
# RABBITMQ_DEFAULT_USER=hub
# RABBITMQ_DEFAULT_PASS=change-me
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=*
DJANGO_DEBUG=0
LOG_LEVEL=INFO

# Host path to the Google service account key used by mailer-worker
GOOGLE_CREDENTIALS_FILE=./secrets/google-credentials.json
